# Copy this file to .env and fill in real values.
# .env is gitignored — never commit your actual token.

# Your Notion integration's "Internal Integration Secret".
# Get / rotate it at: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The database ID from your Notion database URL.
# From a URL like https://app.notion.com/p/<id>?v=...
# the ID is the 32-character hex string right after /p/
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the local server runs on
PORT=3000
